   "source": [
    "class Einkaufswagen: # Klasse A\n",
    "    def __init__(self):\n",
    "        self.artikel_liste = []\n",
    "\n",
    "    def füge_neuen_artikel_hinzu(self, name: str, preis: float, anzahl: int):\n",
    "        artikel = Artikel(name, preis, anzahl)\n",
    "        self.artikel_liste.append(artikel)\n",
    "        print(f\"{anzahl} x {name} wurde hinzugefügt\")\n",
    "        \n",
    "        return artikel\n",
    "\n",
    "    def berechne_gesamtpreis(self):\n",
    "        gesamtpreis = 0\n",
    "\n",
    "        for artikel in self.artikel_liste:\n",
    "            gesamtpreis = gesamtpreis + artikel.preis * artikel.anzahl\n",
    "\n",
    "        return gesamtpreis"
   ]
