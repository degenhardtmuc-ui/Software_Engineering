   "source": [
    "public int berechne_fakultaet(int n) {\n",
    "    int ergebnis = 1;\n",
    "\n",
    "    for (int i = 1; i <= n; i++) {\n",
    "        ergebnis = ergebnis * i;\n",
    "    }\n",
    "\n",
    "    return ergebnis;\n",
    "}"
   ]
