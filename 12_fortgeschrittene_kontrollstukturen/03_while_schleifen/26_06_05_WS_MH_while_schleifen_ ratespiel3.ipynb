    "def rate_zahl():\n",
    "    \"\"\"Ask the user for a number until it is correct.\"\"\"\n",
    "    loesung = 7\n",
    "    tipp = 0\n",
    "\n",
    "    while tipp != loesung:\n",
    "        tipp = int(input(\"Rate eine Zahl: \"))\n",
    "\n",
    "    print(\"Richtig! Die Zahl war 7.\") "
   ]
